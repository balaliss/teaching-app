# ---- Database -------------------------------------------------------------
# Local Docker Compose value shown; swap for a Neon/Fly/Render/Supabase string
# when deploying. See docs/DEPLOY.md.
DATABASE_URL="postgresql://teaching:teaching@localhost:5432/teaching_app?schema=public"

# The connection migrations run through. On a pooled host (Neon, Supabase,
# PgBouncer) set this to the UNPOOLED string — migrations cannot run through a
# transaction pooler. Locally there is no pooler, so it is the same value as
# DATABASE_URL. It must always be a valid connection string, never empty.
DIRECT_URL="postgresql://teaching:teaching@localhost:5432/teaching_app?schema=public"

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
# Set to your public URL when self-hosting (e.g. https://teaching.example.org).
# Leave UNSET on Vercel — Auth.js reads the deployment URL itself.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---- Seeded admin account -------------------------------------------------
SEED_ADMIN_EMAIL="you@example.org"
SEED_ADMIN_PASSWORD="change-this-after-first-login"
SEED_ADMIN_NAME="Admin"

# ---- Claude ---------------------------------------------------------------
# One shared server-side key. Never exposed to the browser.
ANTHROPIC_API_KEY=""
# Cheaper model for pulling structure out of uploaded PDFs.
CLAUDE_STRUCTURE_MODEL="claude-sonnet-5"
# Stronger model for writing the actual teaching instructions. On a host with a
# 60-second function limit (Vercel Hobby) use claude-sonnet-5 instead — see
# docs/DEPLOY.md.
CLAUDE_GRID_MODEL="claude-opus-5"

# Default monthly token cap applied to newly registered teachers.
# Total input+output tokens per calendar month. Leave blank for unlimited.
DEFAULT_MONTHLY_TOKEN_CAP="2000000"

# ---- File storage ---------------------------------------------------------
# disk = local filesystem (Docker / single machine).  s3 = any S3-compatible bucket.
STORAGE_DRIVER="disk"
STORAGE_DISK_PATH="./storage/uploads"

# Only needed when STORAGE_DRIVER=s3.
# For Cloudflare R2: leave S3_REGION blank and set S3_ENDPOINT to
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: set S3_REGION and leave S3_ENDPOINT blank.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Max upload size in megabytes.
MAX_UPLOAD_MB="25"
